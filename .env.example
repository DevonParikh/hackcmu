# MongoDB connection string. Local: mongodb://127.0.0.1:27017/tailor  Atlas: mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/tailor

# Anthropic API key. When unset, Tailor runs in demo mode: it still crawls the
# real site and stores everything in MongoDB, but analysis text and tool replies
# come from deterministic heuristics instead of Claude.
ANTHROPIC_API_KEY=

# Optional model overrides
TAILOR_MODEL_MAIN=claude-opus-5
TAILOR_MODEL_WORKER=claude-sonnet-5
TAILOR_MODEL_RUNTIME=claude-sonnet-5

# Force demo mode even when a key is present (1 = demo)
TAILOR_DEMO=

# Public base URL used in embed snippets (defaults to the request origin)
NEXT_PUBLIC_BASE_URL=

# Local development only: allow analyzing sites on localhost / private networks (1 = allow).
TAILOR_ALLOW_PRIVATE_URLS=

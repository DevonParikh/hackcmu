# ---- the money rail (money/) and the voice agent (prototype/). `npm run floor` fills the chain lines in and keeps the rest.
# SOLANA_RPC=https://api.devnet.solana.com       devnet (default). http://127.0.0.1:8899 = `npm run localnet`. Never mainnet.
# MINT= DECIMALS= OWNER_PUBKEY= OWNER_ATA= AGENT_PUBKEY= AGENT_KEYPAIR= RAVI_PUBKEY= RAVI_ATA=   written by npm run floor
# CONTACTS=alice=<token account>,bob=<token account>    extra names the agent knows
# ELEVENLABS_API_KEY=        spoken read-back; without it the browser voice speaks
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# AUTH0_ISSUER_BASE_URL=https://<tenant>.us.auth0.com   AUTH0_CLIENT_ID=   AUTH0_SECRET=<32+ random chars>   AUTH0_BASE_URL=https://agent.example.com
# DELEGATES=alice@x.com=keys/agent.json               login → delegate keypair (default: AGENT_KEYPAIR)

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/tailor  Atlas: mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/tailor

# ---- AI providers for the analysis, the evidence judge, and the deployed tools (lib/llm.ts).
# Set at least one. They are tried in this order; a provider that runs out of quota is skipped for the rest of the process.

# 1. Claude. ANTHROPIC_MODEL defaults to claude-opus-5. Web search for reviews and competitors uses Anthropic's server-side tool.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# 2. Gemini. Several keys, comma-separated, in GEMINI_API_KEYS; or one key in GEMINI_API_KEY.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# 3. xAI (Grok), with web search on the Responses endpoint.
XAI_API_KEY=
# XAI_MODEL=grok-4.20-non-reasoning

# 4. Any OpenAI-compatible chat endpoint: OpenAI itself, or Groq, Together, OpenRouter, a local Ollama or vLLM server.
#    No web search; text and JSON only. OPENAI_BASE_URL defaults to https://api.openai.com/v1.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# 5. IFM K2 Horizon (OpenAI-compatible gateway). Also runs the evidence judge first when set.
# IFM_API_KEY=
# IFM_BASE_URL=https://platform.ifm.ai/v1
# IFM_MODEL=IFM/K2-Horizon-7B

# Optional: a locally trained evidence judge (scripts/judge.py serve) used instead of an LLM for relevance verdicts.
# JUDGE_URL=http://127.0.0.1:8001

# Public base URL used in embed snippets (defaults to the request origin)
NEXT_PUBLIC_BASE_URL=
